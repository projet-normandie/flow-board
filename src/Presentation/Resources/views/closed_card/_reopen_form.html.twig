<form method="post" action="{{ path('app_card_reopen', { id: card.id }) }}" class="d-inline" onsubmit="return confirm('{{ 'closed_card.confirm_reopen'|trans }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('reopen' ~ card.id) }}">
    <button type="submit" class="btn btn-sm btn-outline-success">
        <i class="bi bi-arrow-counterclockwise me-1"></i>{{ 'closed_card.reopen'|trans }}
    </button>
</form>
