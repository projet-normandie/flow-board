{% extends '@App/base.html.twig' %}

{% block title %}{{ project.name }} — FlowBoard{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex align-items-center gap-2 mb-4">
        <a href="{{ path('app_home') }}" class="text-decoration-none">
            <span class="badge rounded-pill" style="background-color: {{ project.color }}; font-size: 0.85em;">
                {{ project.name }}
            </span>
        </a>
    </div>

    <div class="text-center py-5">
        <i class="bi bi-kanban text-muted" style="font-size: 3rem;"></i>
        <p class="text-muted mt-3">{{ 'board.empty'|trans }}</p>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_board_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>{{ 'board.new'|trans }}
            </a>
        {% endif %}
    </div>
</div>
{% endblock %}
