{% extends '@App/base.html.twig' %}

{% block title %}{{ board.name }} — {{ project.name }} — FlowBoard{% endblock %}

{% block body %}
<div class="container-fluid mt-3 px-3">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message|trans }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="d-flex align-items-center gap-2">
            <a href="{{ path('app_home') }}" class="text-decoration-none">
                <span class="badge rounded-pill" style="background-color: {{ project.color }}; font-size: 0.85em;">
                    {{ project.name }}
                </span>
            </a>
            <h1 class="h3 mb-0">
                <i class="bi bi-kanban me-2"></i>{{ board.name }}
            </h1>
        </div>
        <div class="d-flex align-items-center gap-3">
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_card_new') }}" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>{{ 'card.new'|trans }}
                </a>
            {% endif %}
        </div>
    </div>

    <ul class="nav nav-tabs mb-3">
        {% for b in boards %}
            <li class="nav-item">
                <a class="nav-link{{ b.id == board.id ? ' active' : '' }}"
                   href="{{ path('app_project_board', { id: project.id, boardId: b.id }) }}">
                    {{ b.name }}
                </a>
            </li>
        {% endfor %}
    </ul>

    {% include '@App/board/_content.html.twig' %}
</div>
{% endblock %}
