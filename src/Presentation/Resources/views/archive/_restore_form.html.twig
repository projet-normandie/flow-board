<form method="post" action="{{ path('app_archive_restore', { id: card.id }) }}" class="d-inline" onsubmit="return confirm('{{ 'archive.confirm_restore'|trans }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('restore' ~ card.id) }}">
    <button type="submit" class="btn btn-sm btn-outline-success">
        <i class="bi bi-arrow-counterclockwise me-1"></i>{{ 'archive.restore'|trans }}
    </button>
</form>
