<!DOCTYPE html>
<html>
    <body>
        <p>{{ 'reset_password.email.greeting'|trans }}</p>

        <p>{{ 'reset_password.email.intro'|trans }}</p>

        <p>
            <a href="{{ url('app_reset_password', { token: resetToken.token }) }}">
                {{ 'reset_password.email.cta'|trans }}
            </a>
        </p>

        <p>
            {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}
        </p>

        <p>{{ 'reset_password.email.ignore'|trans }}</p>
    </body>
</html>
