{% extends '@App/base.html.twig' %}

{% block title %}{{ 'reset_password.check_email.title'|trans }} — FlowBoard{% endblock %}

{% block body %}
<div class="d-flex align-items-center justify-content-center min-vh-100">
    <div class="card shadow-sm" style="width: 100%; max-width: 400px;">
        <div class="card-body p-4 text-center">
            <h1 class="card-title mb-4 fs-4">
                <i class="bi bi-envelope-check me-2"></i>{{ 'reset_password.check_email.title'|trans }}
            </h1>

            <p class="text-muted">{{ 'reset_password.check_email.help'|trans }}</p>

            <a href="{{ path('app_login') }}" class="btn btn-primary w-100 mt-3">
                {{ 'reset_password.back_to_login'|trans }}
            </a>
        </div>
    </div>
</div>
{% endblock %}
