{% extends '@App/base.html.twig' %}

{% block title %}{{ 'reset_password.reset.title'|trans }} — FlowBoard{% endblock %}

{% block body %}
<div class="d-flex align-items-center justify-content-center min-vh-100">
    <div class="card shadow-sm" style="width: 100%; max-width: 400px;">
        <div class="card-body p-4">
            <h1 class="card-title text-center mb-4 fs-4">
                <i class="bi bi-kanban me-2"></i>FlowBoard
            </h1>

            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }}">{{ message|trans }}</div>
                {% endfor %}
            {% endfor %}

            {{ form_start(resetForm) }}
                {{ form_row(resetForm.plainPassword.first) }}
                {{ form_row(resetForm.plainPassword.second) }}

                <button type="submit" class="btn btn-primary w-100">
                    {{ 'reset_password.reset.submit'|trans }}
                </button>
            {{ form_end(resetForm) }}
        </div>
    </div>
</div>
{% endblock %}
