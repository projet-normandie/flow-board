<div class="card card-item card-priority-{{ card.priority ? card.priority.value : 'none' }}" data-card-id="{{ card.id }}">
    <div class="card-body p-2">
        <div class="d-flex justify-content-between align-items-start">
            <h6 class="card-title mb-1">
            <a href="#" class="text-decoration-none text-body" onclick="event.preventDefault(); openAjaxModal('{{ path('app_card_show', { id: card.id }) }}')">
                {{ card.title }}
            </a>
            </h6>
            {% if is_granted('CARD_EDIT', card) %}
                <button type="button" class="btn btn-sm btn-link text-muted p-0" title="{{ 'card.edit'|trans }}" onclick="event.stopPropagation(); openAjaxModal('{{ path('app_card_edit_modal', { id: card.id }) }}')">
                    <i class="bi bi-pencil"></i>
                </button>
            {% endif %}
        </div>

        {% if card.labels|length > 0 %}
            <div class="mb-1">
                {% for label in card.labels %}
                    <span class="badge rounded-pill" style="background-color: {{ label.color }}; font-size: 0.65em;">
                        {{ label.name }}
                    </span>
                {% endfor %}
            </div>
        {% endif %}

        <div class="d-flex justify-content-between align-items-center mt-2">
            <div class="d-flex align-items-center gap-2">
                <div class="avatar-group">
                    {% for assignee in card.assignees %}
                        <span class="avatar-circle" title="{{ assignee.fullName }}">
                            {{ assignee.fullName|first|upper }}
                        </span>
                    {% endfor %}
                </div>
                {% if card.priority %}
                    <span class="badge card-priority-badge-{{ card.priority.value }}" style="font-size: 0.6em;">
                        {{ ('card.priority.' ~ card.priority.value)|trans }}
                    </span>
                {% endif %}
            </div>
            {% if card.dueDate %}
                {% set now = "now"|date("U") %}
                {% set due = card.dueDate|date("U") %}
                {% set diff_days = ((due - now) / 86400)|round(0, 'floor') %}
                <small class="due-date {% if diff_days < 0 %}due-date-overdue{% elseif diff_days < 3 %}due-date-soon{% endif %}">
                    <i class="bi bi-calendar-event me-1"></i>{{ card.dueDate|date('d/m/Y') }}
                </small>
            {% endif %}
        </div>
    </div>
</div>
