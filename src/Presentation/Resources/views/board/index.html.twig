{% extends '@App/base.html.twig' %}

{% block title %}{{ board.name }} — {{ board.project.name }} — FlowBoard{% endblock %}

{% block body %}
<div class="container-fluid mt-3 px-3">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message|trans }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-pill" style="background-color: {{ board.project.color }}; font-size: 0.85em;">
                {{ board.project.name }}
            </span>
            <h1 class="h3 mb-0">
                <i class="bi bi-kanban me-2"></i>{{ board.name }}
            </h1>
        </div>
        <div class="d-flex align-items-center gap-3">
            <select class="form-select form-select-sm" style="width: auto;" onchange="window.location.href = '{{ path('app_board', { id: '__ID__' }) }}'.replace('__ID__', this.value)">
                {% for b in boards %}
                    <option value="{{ b.id }}" {{ b.id == board.id ? 'selected' : '' }}>
                        {{ b.project.name }} — {{ b.name }}
                    </option>
                {% endfor %}
            </select>
            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('app_card_new') }}" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>{{ 'card.new'|trans }}
                </a>
            {% endif %}
        </div>
    </div>

    <div class="board-container" data-controller="sortable">
        {% for column in columns %}
            {% set columnCards = cardsByColumn[column.id] ?? [] %}
            <div class="board-column">
                <div class="board-column-header">
                    <span class="fw-semibold">{{ column.name }}</span>
                    <span class="badge bg-secondary ms-2">{{ columnCards|length }}</span>
                </div>
                <div class="board-column-body sortable-list" data-sortable-column-id="{{ column.id }}">
                    {% for card in columnCards %}
                        {% include '@App/board/_card.html.twig' %}
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
