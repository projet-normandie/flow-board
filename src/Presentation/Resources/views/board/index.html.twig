{% extends '@App/base.html.twig' %}

{% block title %}{{ 'board.title'|trans }} — FlowBoard{% endblock %}

{% block body %}
<div class="container-fluid mt-3 px-3">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message|trans }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="h3 mb-0">
            <i class="bi bi-kanban me-2"></i>{{ 'board.title'|trans }}
        </h1>
        <div class="d-flex align-items-center gap-3">
            <select class="form-select form-select-sm" style="width: auto;" onchange="window.location.href = this.value ? '{{ path('app_board') }}?project=' + this.value : '{{ path('app_board') }}'">
                <option value="">{{ 'board.all_projects'|trans }}</option>
                {% for project in projects %}
                    <option value="{{ project.id }}" {{ selectedProject and selectedProject.id == project.id ? 'selected' : '' }}>
                        {{ project.name }}
                    </option>
                {% endfor %}
            </select>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_card_new') }}" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>{{ 'card.new'|trans }}
                </a>
            {% endif %}
        </div>
    </div>

    <div class="board-container" data-controller="sortable">
        {% for column in columns %}
            <div class="board-column">
                <div class="board-column-header">
                    <span class="fw-semibold">{{ column.name }}</span>
                    <span class="badge bg-secondary ms-2">
                        {% set count = 0 %}
                        {% for card in column.cards %}
                            {% if not selectedProject or card.project.id == selectedProject.id %}
                                {% set count = count + 1 %}
                            {% endif %}
                        {% endfor %}
                        {{ count }}
                    </span>
                </div>
                <div class="board-column-body sortable-list" data-sortable-column-id="{{ column.id }}">
                    {% for card in column.cards %}
                        {% if not selectedProject or card.project.id == selectedProject.id %}
                            {% include '@App/board/_card.html.twig' %}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
