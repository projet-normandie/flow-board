{% extends '@App/base.html.twig' %}

{% block title %}{{ 'nav.projects'|trans }} — FlowBoard{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="bi bi-folder me-2"></i>{{ 'nav.projects'|trans }}
        </h1>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_project_new') }}" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg me-1"></i>{{ 'project.new'|trans }}
            </a>
        {% endif %}
    </div>

    {% if projects|length == 0 %}
        <p class="text-muted">{{ 'project.empty'|trans }}</p>
    {% else %}
        <div class="row g-4">
            {% for project in projects %}
                <div class="col-sm-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-header d-flex align-items-center gap-2" style="border-left: 4px solid {{ project.color }};">
                            <a href="{{ path('app_project', { id: project.id }) }}" class="fw-semibold text-decoration-none text-body">{{ project.name }}</a>
                        </div>
                        <div class="card-body">
                            {% if project.boards|length == 0 %}
                                <p class="text-muted small mb-0">{{ 'board.empty'|trans }}</p>
                            {% else %}
                                <ul class="list-unstyled mb-0">
                                    {% for board in project.boards %}
                                        <li class="mb-1">
                                            <a href="{{ path('app_project_board', { id: project.id, boardId: board.id }) }}" class="text-decoration-none">
                                                <i class="bi bi-kanban me-1 text-muted"></i>{{ board.name }}
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                        {% if is_granted('ROLE_ADMIN') %}
                            <div class="card-footer text-end">
                                <a href="{{ path('admin_board_new') }}" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-plus-lg me-1"></i>{{ 'board.new'|trans }}
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {# Recent activity #}
    {% if recentActivity|length > 0 %}
        <div class="mt-5">
            <h2 class="h4 mb-3">
                <i class="bi bi-clock-history me-2"></i>{{ 'activity.recent'|trans }}
            </h2>
            <div class="list-group">
                {% for entry in recentActivity %}
                    <div class="list-group-item">
                        <div class="d-flex align-items-center gap-2">
                            {% if entry.item.userEmail %}
                                <img class="avatar-circle flex-shrink-0" src="{{ entry.item.userEmail|gravatar }}" alt="{{ entry.item.username }}">
                            {% else %}
                                <span class="avatar-circle flex-shrink-0 bg-secondary d-inline-flex align-items-center justify-content-center">
                                    <i class="bi bi-person text-white"></i>
                                </span>
                            {% endif %}
                            <div class="flex-grow-1 min-width-0">
                                <div class="small">
                                    <strong>{{ entry.item.username }}</strong>
                                    {% if entry.item.activityType.value == 'comment' %}
                                        {{ 'comment.title'|trans|lower }}
                                    {% else %}
                                        {{ entry.item.translationKey|trans(entry.item.translationParams ?? {}) }}
                                    {% endif %}
                                    {% if entry.card %}
                                        <span class="text-muted">{{ 'activity.on_card'|trans }}</span>
                                        <a href="#" onclick="openAjaxModal('{{ path('app_card_show', { id: entry.card.id }) }}'); return false;" class="text-decoration-none fw-semibold">
                                            {{ entry.card.title }}
                                        </a>
                                    {% endif %}
                                </div>
                                <small class="text-muted">{{ entry.item.occurredAt|date('d/m/Y H:i') }}</small>
                            </div>
                            {% if entry.item.iconClass %}
                                <i class="bi {{ entry.item.iconClass }} text-muted"></i>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
