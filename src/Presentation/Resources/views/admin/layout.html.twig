{% extends '@App/base.html.twig' %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <nav class="col-lg-2 admin-sidebar d-none d-lg-block">
            <div class="admin-sidebar-sticky pt-3">
                <h6 class="admin-sidebar-heading px-3 mb-2 text-uppercase">
                    {{ 'admin.title'|trans }}
                </h6>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link{{ app.request.pathInfo == '/admin' ? ' active' : '' }}" href="{{ path('admin_dashboard') }}">
                            <i class="bi bi-speedometer2 me-2"></i>{{ 'admin.dashboard'|trans }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link{{ app.request.pathInfo starts with '/admin/projects' ? ' active' : '' }}" href="{{ path('admin_project_index') }}">
                            <i class="bi bi-folder me-2"></i>{{ 'nav.projects'|trans }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link{{ app.request.pathInfo starts with '/admin/boards' ? ' active' : '' }}" href="{{ path('admin_board_index') }}">
                            <i class="bi bi-kanban me-2"></i>{{ 'nav.boards'|trans }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link{{ app.request.pathInfo starts with '/admin/labels' ? ' active' : '' }}" href="{{ path('admin_label_index') }}">
                            <i class="bi bi-tags me-2"></i>{{ 'nav.labels'|trans }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link{{ app.request.pathInfo starts with '/admin/columns' ? ' active' : '' }}" href="{{ path('admin_column_index') }}">
                            <i class="bi bi-layout-three-columns me-2"></i>{{ 'nav.columns'|trans }}
                        </a>
                    </li>
                    {% if is_granted('ROLE_SUPER_ADMIN') %}
                        <li class="nav-item">
                            <a class="nav-link{{ app.request.pathInfo starts with '/admin/users' ? ' active' : '' }}" href="{{ path('admin_user_index') }}">
                                <i class="bi bi-people me-2"></i>{{ 'nav.users'|trans }}
                            </a>
                        </li>
                    {% endif %}
                    <li class="nav-item">
                        <a class="nav-link{{ app.request.pathInfo starts with '/audit' ? ' active' : '' }}" href="{{ path('dh_auditor_list_audits') }}">
                            <i class="bi bi-clock-history me-2"></i>{{ 'admin.audit'|trans }}
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <main class="col-lg-10 ms-sm-auto px-4 py-3">
            {% block admin_content %}{% endblock %}
        </main>
    </div>
</div>
{% endblock %}
