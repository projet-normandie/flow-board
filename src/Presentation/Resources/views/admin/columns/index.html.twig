{% extends '@App/admin/layout.html.twig' %}

{% block title %}{{ 'column.title'|trans }} — FlowBoard{% endblock %}

{% block admin_content %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>{{ 'column.title'|trans }}</h1>
        <a href="{{ path('admin_column_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>{{ 'column.new'|trans }}
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message|trans }}</div>
    {% endfor %}

    <table class="table table-striped">
        <thead>
            <tr>
                <th>{{ 'common.position'|trans }}</th>
                <th>{{ 'common.name'|trans }}</th>
                <th>{{ 'common.created_at'|trans }}</th>
                <th>{{ 'common.updated_at'|trans }}</th>
                <th>{{ 'common.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for column in columns %}
                <tr>
                    <td>{{ column.position }}</td>
                    <td>{{ column.name }}</td>
                    <td>{{ column.createdAt ? column.createdAt|date('Y-m-d H:i') : '—' }}</td>
                    <td>{{ column.updatedAt ? column.updatedAt|date('Y-m-d H:i') : '—' }}</td>
                    <td>
                        <a href="{{ path('admin_column_edit', { id: column.id }) }}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        {% include '@App/admin/columns/_delete_form.html.twig' %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-muted text-center">{{ 'column.empty'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
