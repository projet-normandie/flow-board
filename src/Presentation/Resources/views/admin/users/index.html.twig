{% extends '@App/base.html.twig' %}

{% block title %}{{ 'user.title'|trans }} — FlowBoard{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>{{ 'user.title'|trans }}</h1>
        <a href="{{ path('admin_user_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>{{ 'user.new'|trans }}
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message|trans }}</div>
    {% endfor %}

    <table class="table table-striped">
        <thead>
            <tr>
                <th>{{ 'user.full_name'|trans }}</th>
                <th>{{ 'common.email'|trans }}</th>
                <th>{{ 'user.roles'|trans }}</th>
                <th>{{ 'user.job_title'|trans }}</th>
                <th>{{ 'user.enabled'|trans }}</th>
                <th>{{ 'common.created_at'|trans }}</th>
                <th>{{ 'common.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.fullName }}</td>
                    <td>{{ user.email }}</td>
                    <td>
                        {% for role in user.roles %}
                            <span class="badge bg-secondary">{{ role }}</span>
                        {% endfor %}
                    </td>
                    <td>{{ user.jobTitle ? user.jobTitle.value : '—' }}</td>
                    <td>
                        {% if user.enabled %}
                            <span class="badge bg-success">{{ 'common.yes'|trans }}</span>
                        {% else %}
                            <span class="badge bg-danger">{{ 'common.no'|trans }}</span>
                        {% endif %}
                    </td>
                    <td>{{ user.createdAt ? user.createdAt|date('Y-m-d H:i') : '—' }}</td>
                    <td>
                        <a href="{{ path('admin_user_edit', { id: user.id }) }}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        {% include '@App/admin/users/_delete_form.html.twig' %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="text-muted text-center">{{ 'user.empty'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
