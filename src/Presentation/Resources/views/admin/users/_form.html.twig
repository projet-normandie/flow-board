{{ form_start(form) }}
    {{ form_row(form.fullName) }}
    {{ form_row(form.email) }}
    {{ form_row(form.plainPassword) }}
    {{ form_row(form.roles) }}
    {{ form_row(form.jobTitle) }}
    {{ form_row(form.enabled) }}
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i>{{ button_label|default('common.save'|trans) }}
    </button>
    <a href="{{ path('admin_user_index') }}" class="btn btn-secondary ms-2">{{ 'common.cancel'|trans }}</a>
{{ form_end(form) }}
