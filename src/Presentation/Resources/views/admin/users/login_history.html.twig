{% extends '@App/admin/layout.html.twig' %}

{% block title %}{{ 'login_history.title'|trans }} — {{ user.fullName }} — FlowBoard{% endblock %}

{% block admin_content %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>{{ 'login_history.title'|trans }} — {{ user.fullName }}</h1>
        <a href="{{ path('admin_user_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>{{ 'common.cancel'|trans }}
        </a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>{{ 'login_history.date'|trans }}</th>
                <th>{{ 'login_history.ip_address'|trans }}</th>
                <th>{{ 'login_history.user_agent'|trans }}</th>
                <th>{{ 'login_history.auth_type'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for entry in loginHistories %}
                <tr>
                    <td>{{ entry.createdAt|date('Y-m-d H:i') }}</td>
                    <td>{{ entry.ipAddress }}</td>
                    <td><small>{{ entry.userAgent|u.truncate(80, '...') }}</small></td>
                    <td>
                        <span class="badge bg-secondary">{{ ('login_history.auth_type.' ~ entry.authType.value)|trans }}</span>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-muted text-center">{{ 'login_history.empty'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
