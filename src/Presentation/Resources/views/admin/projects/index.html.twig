{% extends '@App/admin/layout.html.twig' %}

{% block title %}{{ 'project.title'|trans }} — FlowBoard{% endblock %}

{% block admin_content %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>{{ 'project.title'|trans }}</h1>
        <a href="{{ path('admin_project_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>{{ 'project.new'|trans }}
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message|trans }}</div>
    {% endfor %}

    <table class="table table-striped">
        <thead>
            <tr>
                <th>{{ 'common.name'|trans }}</th>
                <th>{{ 'common.color'|trans }}</th>
                <th>{{ 'common.created_at'|trans }}</th>
                <th>{{ 'common.updated_at'|trans }}</th>
                <th>{{ 'common.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for project in projects %}
                <tr>
                    <td>{{ project.name }}</td>
                    <td>
                        <span class="d-inline-block rounded-circle" style="width: 20px; height: 20px; background-color: {{ project.color }};"></span>
                        {{ project.color }}
                    </td>
                    <td>{{ project.createdAt ? project.createdAt|date('Y-m-d H:i') : '—' }}</td>
                    <td>{{ project.updatedAt ? project.updatedAt|date('Y-m-d H:i') : '—' }}</td>
                    <td>
                        <a href="{{ path('admin_project_edit', { id: project.id }) }}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        {% include '@App/admin/projects/_delete_form.html.twig' %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-muted text-center">{{ 'project.empty'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
