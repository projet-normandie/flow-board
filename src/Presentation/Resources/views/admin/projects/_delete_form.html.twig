<form method="post" action="{{ path('admin_project_delete', { id: project.id }) }}" class="d-inline" onsubmit="return confirm('{{ 'project.confirm_delete'|trans }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
    <button type="submit" class="btn btn-sm btn-outline-danger">
        <i class="bi bi-trash"></i>
    </button>
</form>
