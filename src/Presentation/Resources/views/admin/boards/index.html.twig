{% extends '@App/admin/layout.html.twig' %}

{% block title %}{{ 'board.title'|trans }} — FlowBoard{% endblock %}

{% block admin_content %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>{{ 'board.title'|trans }}</h1>
        <a href="{{ path('admin_board_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>{{ 'board.new'|trans }}
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message|trans }}</div>
    {% endfor %}

    <table class="table table-striped">
        <thead>
            <tr>
                <th>{{ 'common.name'|trans }}</th>
                <th>{{ 'board.project'|trans }}</th>
                <th>{{ 'board.columns_count'|trans }}</th>
                <th>{{ 'common.created_at'|trans }}</th>
                <th>{{ 'common.updated_at'|trans }}</th>
                <th>{{ 'common.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for board in boards %}
                <tr>
                    <td>{{ board.name }}</td>
                    <td>
                        <span class="badge rounded-pill" style="background-color: {{ board.project.color }};">
                            {{ board.project.name }}
                        </span>
                    </td>
                    <td>{{ board.columns|length }}</td>
                    <td>{{ board.createdAt ? board.createdAt|date('Y-m-d H:i') : '—' }}</td>
                    <td>{{ board.updatedAt ? board.updatedAt|date('Y-m-d H:i') : '—' }}</td>
                    <td>
                        <a href="{{ path('app_project_board', { id: board.project.id, boardId: board.id }) }}" class="btn btn-sm btn-outline-secondary" title="{{ 'board.view'|trans }}">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a href="{{ path('admin_board_edit', { id: board.id }) }}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        {% include '@App/admin/boards/_delete_form.html.twig' %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-muted text-center">{{ 'board.empty'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
