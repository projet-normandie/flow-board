<form method="post" action="{{ path('admin_label_delete', { id: label.id }) }}" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this label?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ label.id) }}">
    <button type="submit" class="btn btn-sm btn-outline-danger">
        <i class="bi bi-trash"></i>
    </button>
</form>
