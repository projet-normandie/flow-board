{% extends '@App/admin/layout.html.twig' %}

{% block title %}{{ 'label.title'|trans }} — FlowBoard{% endblock %}

{% block admin_content %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>{{ 'label.title'|trans }}</h1>
        <a href="{{ path('admin_label_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>{{ 'label.new'|trans }}
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message|trans }}</div>
    {% endfor %}

    <table class="table table-striped">
        <thead>
            <tr>
                <th>{{ 'common.name'|trans }}</th>
                <th>{{ 'common.color'|trans }}</th>
                <th>{{ 'common.created_at'|trans }}</th>
                <th>{{ 'common.updated_at'|trans }}</th>
                <th>{{ 'common.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for label in labels %}
                <tr>
                    <td>{{ label.name }}</td>
                    <td>
                        <span class="d-inline-block rounded-circle" style="width: 20px; height: 20px; background-color: {{ label.color }};"></span>
                        {{ label.color }}
                    </td>
                    <td>{{ label.createdAt ? label.createdAt|date('Y-m-d H:i') : '—' }}</td>
                    <td>{{ label.updatedAt ? label.updatedAt|date('Y-m-d H:i') : '—' }}</td>
                    <td>
                        <a href="{{ path('admin_label_edit', { id: label.id }) }}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        {% include '@App/admin/labels/_delete_form.html.twig' %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-muted text-center">{{ 'label.empty'|trans }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
