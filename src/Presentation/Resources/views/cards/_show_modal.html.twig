<div class="ajax-modal-header">
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-secondary">{{ card.column.name }}</span>
        <span class="badge rounded-pill" style="background-color: {{ card.column.board.project.color }};">
            {{ card.column.board.project.name }}
        </span>
    </div>
    <button type="button" class="ajax-modal-close" onclick="closeAjaxModal()">&times;</button>
</div>
<div class="ajax-modal-body ajax-modal-body--split">

    {# ── Left panel ──────────────────────────────────────────────────────── #}
    <div class="card-show-left">

        {# Title #}
        {% if is_granted('CARD_EDIT', card) %}
            <div class="mb-3" data-controller="inline-text"
                 data-inline-text-url-value="{{ path('app_card_update_title', { id: card.id }) }}"
                 data-inline-text-csrf-value="{{ csrf_token('update_title' ~ card.id) }}"
                 data-inline-text-field-value="value">
                <h4 class="card-title-editable mb-0"
                    data-inline-text-target="display"
                    data-action="click->inline-text#startEdit">{{ card.title }}</h4>
                <textarea class="card-title-input"
                          data-inline-text-target="input"
                          data-action="blur->inline-text#handleBlur keydown->inline-text#handleKeydown"
                          rows="1"
                          style="display:none;">{{ card.title }}</textarea>
            </div>
        {% else %}
            <h4 class="mb-3">{{ card.title }}</h4>
        {% endif %}

        {# Meta row #}
        <div class="d-flex flex-wrap gap-4 mb-4 pb-3 border-bottom">
            <div>
                <small class="text-muted d-block mb-1">{{ 'card.assignees'|trans }}</small>
                {% if is_granted('CARD_EDIT', card) %}
                    <div data-controller="inline-assignees"
                         data-inline-assignees-url-value="{{ path('app_card_update_assignees', { id: card.id }) }}"
                         data-inline-assignees-csrf-value="{{ csrf_token('update_assignees' ~ card.id) }}"
                         data-inline-assignees-placeholder-value="{{ 'card.show.add_assignees'|trans }}">
                        <div data-inline-assignees-target="display" class="labels-editable">
                            {% if card.assignees|length > 0 %}
                                <div class="avatar-group">
                                    {% for assignee in card.assignees %}
                                        <img class="avatar-circle" src="{{ assignee.email|gravatar }}" alt="{{ assignee.fullName }}" title="{{ assignee.fullName }}">
                                    {% endfor %}
                                </div>
                            {% else %}
                                <span class="card-description-placeholder">{{ 'card.show.add_assignees'|trans }}</span>
                            {% endif %}
                        </div>
                        <div data-inline-assignees-target="editorContainer" style="display:none;">
                            <select multiple data-inline-assignees-target="select">
                                {% for user in allUsers %}
                                    <option value="{{ user.id }}"
                                            {% if card.assignees.contains(user) %}selected{% endif %}>
                                        {{ user.fullName }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div data-inline-assignees-target="actions" class="mt-2 gap-2" style="display:none;">
                            <button type="button" data-action="inline-assignees#save" class="btn btn-sm btn-primary">{{ 'common.save'|trans }}</button>
                            <button type="button" data-action="inline-assignees#cancel" class="btn btn-sm btn-outline-secondary">{{ 'common.cancel'|trans }}</button>
                        </div>
                    </div>
                {% else %}
                    {% if card.assignees|length > 0 %}
                        <div class="avatar-group">
                            {% for assignee in card.assignees %}
                                <img class="avatar-circle" src="{{ assignee.email|gravatar }}" alt="{{ assignee.fullName }}" title="{{ assignee.fullName }}">
                            {% endfor %}
                        </div>
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endif %}
                {% endif %}
            </div>

            <div>
                <small class="text-muted d-block mb-1">{{ 'card.labels'|trans }}</small>
                {% if is_granted('CARD_EDIT', card) %}
                    <div data-controller="inline-labels"
                         data-placeholder="{{ 'card.show.add_labels'|trans }}"
                         data-inline-labels-url-value="{{ path('app_card_update_labels', { id: card.id }) }}"
                         data-inline-labels-csrf-value="{{ csrf_token('update_labels' ~ card.id) }}">
                        <div data-inline-labels-target="display" class="labels-editable">
                            {% if card.labels|length > 0 %}
                                {% for label in card.labels %}
                                    <span class="badge rounded-pill" style="background-color: {{ label.color }};">{{ label.name }}</span>
                                {% endfor %}
                            {% else %}
                                <span class="card-description-placeholder">{{ 'card.show.add_labels'|trans }}</span>
                            {% endif %}
                        </div>
                        <div data-inline-labels-target="editorContainer" style="display:none;">
                            <select multiple data-inline-labels-target="select">
                                {% for label in allLabels %}
                                    <option value="{{ label.id }}"
                                            data-color="{{ label.color }}"
                                            {% if card.labels.contains(label) %}selected{% endif %}>
                                        {{ label.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div data-inline-labels-target="actions" class="mt-2 gap-2" style="display:none;">
                            <button type="button" data-action="inline-labels#save" class="btn btn-sm btn-primary">{{ 'common.save'|trans }}</button>
                            <button type="button" data-action="inline-labels#cancel" class="btn btn-sm btn-outline-secondary">{{ 'common.cancel'|trans }}</button>
                        </div>
                    </div>
                {% else %}
                    {% if card.labels|length > 0 %}
                        {% for label in card.labels %}
                            <span class="badge rounded-pill" style="background-color: {{ label.color }};">{{ label.name }}</span>
                        {% endfor %}
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endif %}
                {% endif %}
            </div>

            <div>
                <small class="text-muted d-block mb-1">{{ 'card.due_date'|trans }}</small>
                {% if is_granted('CARD_EDIT', card) %}
                    <div class="d-inline-flex align-items-center gap-1"
                         data-controller="inline-date"
                         data-inline-date-url-value="{{ path('app_card_update_due_date', { id: card.id }) }}"
                         data-inline-date-csrf-value="{{ csrf_token('update_due_date' ~ card.id) }}"
                         data-inline-date-current-value="{{ card.dueDate ? card.dueDate|date('Y-m-d') : '' }}"
                         data-inline-date-placeholder-value="{{ 'card.show.add_due_date'|trans }}">
                        {% if card.dueDate %}
                            {% set now = "now"|date("U") %}
                            {% set due = card.dueDate|date("U") %}
                            {% set diff_days = ((due - now) / 86400)|round(0, 'floor') %}
                            <span class="date-editable {% if diff_days < 0 %}text-danger fw-bold{% elseif diff_days < 3 %}text-warning fw-bold{% endif %}"
                                  data-inline-date-target="display">{{ card.dueDate|date('d/m/Y') }}</span>
                            <button type="button" class="btn-date-clear" data-inline-date-target="clear" title="{{ 'common.cancel'|trans }}">&times;</button>
                        {% else %}
                            <span class="date-editable card-description-placeholder" data-inline-date-target="display">{{ 'card.show.add_due_date'|trans }}</span>
                            <button type="button" class="btn-date-clear" data-inline-date-target="clear" style="display:none;">&times;</button>
                        {% endif %}
                        <input type="date" class="card-date-input" data-inline-date-target="input" style="display:none;">
                    </div>
                {% else %}
                    {% if card.dueDate %}
                        {% set now = "now"|date("U") %}
                        {% set due = card.dueDate|date("U") %}
                        {% set diff_days = ((due - now) / 86400)|round(0, 'floor') %}
                        <span class="{% if diff_days < 0 %}text-danger fw-bold{% elseif diff_days < 3 %}text-warning fw-bold{% endif %}">
                            {{ card.dueDate|date('d/m/Y') }}
                        </span>
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endif %}
                {% endif %}
            </div>

            <div>
                <small class="text-muted d-block mb-1">{{ 'card.priority'|trans }}</small>
                {% if is_granted('CARD_EDIT', card) %}
                    {% set priority_labels = {
                        low: 'card.priority.low'|trans,
                        medium: 'card.priority.medium'|trans,
                        high: 'card.priority.high'|trans,
                        critical: 'card.priority.critical'|trans
                    } %}
                    <div class="position-relative d-inline-block"
                         data-controller="inline-priority"
                         data-inline-priority-url-value="{{ path('app_card_update_priority', { id: card.id }) }}"
                         data-inline-priority-csrf-value="{{ csrf_token('update_priority' ~ card.id) }}"
                         data-inline-priority-current-value="{{ card.priority ? card.priority.value : '' }}"
                         data-inline-priority-labels-value="{{ priority_labels|json_encode }}">
                        <span class="priority-editable {% if card.priority %}badge card-priority-badge-{{ card.priority.value }}{% else %}text-muted{% endif %}"
                              data-inline-priority-target="badge">
                            {% if card.priority %}{{ ('card.priority.' ~ card.priority.value)|trans }}{% else %}—{% endif %}
                        </span>
                    </div>
                {% else %}
                    {% if card.priority %}
                        <span class="badge card-priority-badge-{{ card.priority.value }}">
                            {{ ('card.priority.' ~ card.priority.value)|trans }}
                        </span>
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endif %}
                {% endif %}
            </div>

            <div>
                <small class="text-muted d-block mb-1">{{ 'card.reported_by'|trans }}</small>
                {% if is_granted('CARD_EDIT', card) %}
                    <div data-controller="inline-text"
                         data-inline-text-url-value="{{ path('app_card_update_reported_by', { id: card.id }) }}"
                         data-inline-text-csrf-value="{{ csrf_token('update_reported_by' ~ card.id) }}"
                         data-inline-text-allow-empty-value="true"
                         data-inline-text-placeholder-value="{{ 'card.show.add_reported_by'|trans }}">
                        <span class="card-text-editable {% if not card.reportedBy %}card-description-placeholder{% endif %}"
                              data-inline-text-target="display"
                              data-action="click->inline-text#startEdit">{{ card.reportedBy ?: 'card.show.add_reported_by'|trans }}</span>
                        <textarea class="card-inline-input"
                                  data-inline-text-target="input"
                                  data-action="blur->inline-text#handleBlur keydown->inline-text#handleKeydown"
                                  rows="1"
                                  style="display:none;">{{ card.reportedBy }}</textarea>
                    </div>
                {% else %}
                    {% if card.reportedBy %}
                        <span>{{ card.reportedBy }}</span>
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endif %}
                {% endif %}
            </div>
        </div>

        {# Description #}
        <div class="mb-4">
            <h6 class="text-muted mb-2"><i class="bi bi-text-left me-1"></i>{{ 'card.description'|trans }}</h6>
            {% if is_granted('CARD_EDIT', card) %}
                <div data-controller="inline-description"
                     data-inline-description-url-value="{{ path('app_card_update_description', { id: card.id }) }}"
                     data-inline-description-csrf-value="{{ csrf_token('update_description' ~ card.id) }}"
                     data-inline-description-html-value="{{ card.description|default('')|e('html_attr') }}"
                     data-inline-description-placeholder-value="{{ 'card.show.add_description'|trans }}">
                    <div data-inline-description-target="display" class="card-description-editable">
                        {% if card.description %}
                            <div class="card-description ql-editor">{{ card.description|raw }}</div>
                        {% else %}
                            <p class="card-description-placeholder">{{ 'card.show.add_description'|trans }}</p>
                        {% endif %}
                    </div>
                    <div data-inline-description-target="editorContainer" style="display:none;">
                        <div data-inline-description-target="quillDiv" style="min-height:150px;"></div>
                    </div>
                    <div data-inline-description-target="actions" class="mt-2 gap-2" style="display:none;">
                        <button type="button" data-action="inline-description#save" class="btn btn-sm btn-primary">
                            {{ 'common.save'|trans }}
                        </button>
                        <button type="button" data-action="inline-description#cancel" class="btn btn-sm btn-outline-secondary">
                            {{ 'common.cancel'|trans }}
                        </button>
                    </div>
                </div>
            {% else %}
                {% if card.description %}
                    <div class="card-description ql-editor">{{ card.description|raw }}</div>
                {% else %}
                    <p class="text-muted fst-italic">{{ 'card.show.no_description'|trans }}</p>
                {% endif %}
            {% endif %}
        </div>

        {# Checklists #}
        {% if card.checklists|length > 0 or is_granted('CARD_EDIT', card) %}
            <div class="mb-4">
                <h6 class="text-muted mb-2"><i class="bi bi-check2-square me-1"></i>{{ 'checklist.title'|trans }}</h6>

                {% for checklist in card.checklists %}
                    <div class="mb-3"
                         data-controller="checklist-progress"
                         data-checklist-progress-total-value="{{ checklist.totalCount }}">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            {% if is_granted('CARD_EDIT', card) %}
                                <div data-controller="inline-text"
                                     data-inline-text-url-value="{{ path('app_checklist_update_title', { id: checklist.id }) }}"
                                     data-inline-text-csrf-value="{{ csrf_token('update_checklist_title' ~ checklist.id) }}"
                                     data-inline-text-field-value="value">
                                    <strong class="small card-text-editable"
                                            data-inline-text-target="display"
                                            data-action="click->inline-text#startEdit">{{ checklist.title }}</strong>
                                    <textarea class="card-inline-input fw-bold"
                                              data-inline-text-target="input"
                                              data-action="blur->inline-text#handleBlur keydown->inline-text#handleKeydown"
                                              rows="1"
                                              style="display:none;">{{ checklist.title }}</textarea>
                                </div>
                            {% else %}
                                <strong class="small">{{ checklist.title }}</strong>
                            {% endif %}
                            <small class="text-muted" data-checklist-progress-target="counter">{{ checklist.checkedCount }}/{{ checklist.totalCount }}</small>
                        </div>
                        {% if checklist.totalCount > 0 %}
                            <div class="progress mb-2" style="height: 6px;">
                                <div class="progress-bar"
                                     data-checklist-progress-target="progressBar"
                                     style="width: {{ checklist.totalCount > 0 ? (checklist.checkedCount / checklist.totalCount * 100)|round : 0 }}%;"></div>
                            </div>
                        {% endif %}

                        {% for item in checklist.items %}
                            <div class="d-flex align-items-center gap-2 mb-1 checklist-item-row">
                                {% if is_granted('CARD_EDIT', card) %}
                                    <input type="checkbox"
                                           class="form-check-input mt-0 flex-shrink-0"
                                           {% if item.checked %}checked{% endif %}
                                           data-action="change->checklist-progress#toggle"
                                           data-url="{{ path('app_checklist_item_toggle', { id: item.id }) }}"
                                           data-csrf="{{ csrf_token('toggle_item' ~ item.id) }}">
                                    <div class="flex-grow-1"
                                         data-controller="inline-text"
                                         data-inline-text-url-value="{{ path('app_checklist_item_update_title', { id: item.id }) }}"
                                         data-inline-text-csrf-value="{{ csrf_token('update_item_title' ~ item.id) }}"
                                         data-inline-text-field-value="value">
                                        <span class="checklist-item-label card-text-editable {{ item.checked ? 'text-decoration-line-through text-muted' : '' }}"
                                              data-inline-text-target="display"
                                              data-action="click->inline-text#startEdit">{{ item.title }}</span>
                                        <textarea class="card-inline-input"
                                                  data-inline-text-target="input"
                                                  data-action="blur->inline-text#handleBlur keydown->inline-text#handleKeydown"
                                                  rows="1"
                                                  style="display:none;">{{ item.title }}</textarea>
                                    </div>
                                {% else %}
                                    <i class="bi {{ item.checked ? 'bi-check-circle-fill text-success' : 'bi-circle text-muted' }} flex-shrink-0"></i>
                                    <span class="checklist-item-label {{ item.checked ? 'text-decoration-line-through text-muted' : '' }}">{{ item.title }}</span>
                                {% endif %}
                            </div>
                        {% endfor %}

                        {% if is_granted('CARD_EDIT', card) %}
                            <details class="mt-1">
                                <summary class="text-muted small" style="cursor:pointer; list-style:none;">
                                    <i class="bi bi-plus me-1"></i>{{ 'checklist.add_item'|trans }}
                                </summary>
                                <form data-ajax-form
                                      action="{{ path('app_checklist_item_create', { id: checklist.id }) }}"
                                      method="POST"
                                      class="d-flex gap-2 mt-2">
                                    <input type="hidden" name="_token" value="{{ csrf_token('create_item' ~ checklist.id) }}">
                                    <input type="text" name="title" class="form-control form-control-sm"
                                           placeholder="{{ 'checklist.item.placeholder'|trans }}" required autofocus>
                                    <button type="submit" class="btn btn-sm btn-primary">{{ 'common.save'|trans }}</button>
                                </form>
                            </details>
                        {% endif %}
                    </div>
                {% endfor %}

                {% if is_granted('CARD_EDIT', card) %}
                    <details class="mt-2">
                        <summary class="text-muted small" style="cursor:pointer; list-style:none;">
                            <i class="bi bi-plus-circle me-1"></i>{{ 'checklist.add'|trans }}
                        </summary>
                        <form data-ajax-form
                              action="{{ path('app_card_checklist_create', { id: card.id }) }}"
                              method="POST"
                              class="d-flex gap-2 mt-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('create_checklist' ~ card.id) }}">
                            <input type="text" name="title" class="form-control form-control-sm"
                                   placeholder="{{ 'checklist.title.placeholder'|trans }}" required>
                            <button type="submit" class="btn btn-sm btn-primary">{{ 'common.save'|trans }}</button>
                        </form>
                    </details>
                {% endif %}
            </div>
        {% endif %}

        {# Author #}
        <div class="border-top pt-3 mt-auto">
            <div class="d-flex align-items-center">
                <img class="avatar-circle me-2" src="{{ card.author.email|gravatar }}" alt="{{ card.author.fullName }}">
                <div>
                    <small class="fw-semibold">{{ card.author.fullName }}</small>
                    <small class="text-muted d-block">{{ 'card.show.created_on'|trans({ '%date%': card.createdAt|date('d/m/Y H:i') }) }}</small>
                </div>
            </div>
        </div>

    </div>

    {# ── Right panel ─────────────────────────────────────────────────────── #}
    <div class="card-show-right">

        <div class="card-show-right-header">
            <h6 class="text-muted mb-0"><i class="bi bi-chat-left-text me-1"></i>{{ 'comment.title'|trans }}</h6>
        </div>

        <div class="card-show-right-form">
            <form data-ajax-form action="{{ path('app_comment_create', { id: card.id }) }}" method="POST">
                <textarea name="content" class="form-control form-control-sm mb-2" rows="2" placeholder="{{ 'comment.placeholder'|trans }}" required></textarea>
                <div class="text-end">
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-send me-1"></i>{{ 'comment.submit'|trans }}
                    </button>
                </div>
            </form>
        </div>

        <div class="card-show-right-timeline">
            {% if timeline is defined and timeline|length > 0 %}
                {% for item in timeline %}
                    {% if item.activityType.value == 'comment' %}
                        <div class="comment-item mb-3">
                            <div class="d-flex align-items-start gap-2">
                                <img class="avatar-circle flex-shrink-0" src="{{ item.userEmail|gravatar }}" alt="{{ item.username }}">
                                <div class="flex-grow-1 min-width-0">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <small class="fw-semibold">{{ item.username }}</small>
                                        <small class="text-muted">{{ item.occurredAt|date('d/m/Y H:i') }}</small>
                                    </div>
                                    <div class="comment-content small">{{ item.commentContent|nl2br }}</div>
                                    {% if item.commentAuthorId == app.user.id or is_granted('ROLE_ADMIN') %}
                                        <form data-ajax-form data-confirm="{{ 'comment.confirm_delete'|trans }}" action="{{ path('app_comment_delete', { id: item.commentId }) }}" method="POST" class="mt-1">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_comment' ~ item.commentId) }}">
                                            <button type="submit" class="btn btn-link btn-sm text-danger p-0">
                                                <small><i class="bi bi-trash me-1"></i>{{ 'comment.delete'|trans }}</small>
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="mb-2">
                            <div class="d-flex align-items-center gap-2 text-muted small">
                                <i class="bi {{ item.iconClass }}"></i>
                                <span>
                                    <strong>{{ item.username }}</strong>
                                    {{ item.translationKey|trans(item.translationParams ?? {}) }}
                                </span>
                                <span class="ms-auto text-nowrap">{{ item.occurredAt|date('d/m/Y H:i') }}</span>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            {% else %}
                <div class="text-center text-muted py-4">
                    <i class="bi bi-chat-left d-block mb-2" style="font-size: 1.5rem;"></i>
                    <small>{{ 'activity.empty'|trans }}</small>
                </div>
            {% endif %}
        </div>

    </div>

</div>
