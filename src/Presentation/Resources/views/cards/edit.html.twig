{% extends '@App/base.html.twig' %}

{% block title %}{{ 'card.edit'|trans }} — FlowBoard{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>{{ 'card.edit'|trans }}</h1>

    {% include '@App/cards/_form.html.twig' with { button_label: 'common.update'|trans } %}

