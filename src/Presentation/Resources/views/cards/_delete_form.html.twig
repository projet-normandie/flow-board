<form method="post" action="{{ path('app_card_delete', { id: card.id }) }}" class="d-inline" onsubmit="return confirm('{{ 'card.confirm_delete'|trans }}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ card.id) }}">
    <button type="submit" class="btn btn-sm btn-outline-danger">
        <i class="bi bi-trash me-1"></i>{{ 'card.delete'|trans }}
    </button>
</form>
