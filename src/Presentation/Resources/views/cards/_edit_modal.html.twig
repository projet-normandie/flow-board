<div class="ajax-modal-header">
    <div class="d-flex align-items-center gap-2">
        <h5 class="ajax-modal-title mb-0">{{ 'card.edit'|trans }}</h5>
        <span class="badge bg-secondary">{{ card.column.name }}</span>
    </div>
    <button type="button" class="ajax-modal-close" onclick="closeAjaxModal()">&times;</button>
</div>
<div class="ajax-modal-body">
    {{ form_start(form, { action: path('app_card_edit_modal', { id: card.id }), attr: { 'data-ajax-form': '' } }) }}
        <div class="row">
            <div class="col-md-8">
                {{ form_row(form.title) }}
            </div>
            <div class="col-md-4">
                {{ form_row(form.reportedBy) }}
            </div>
        </div>
        {{ form_row(form.description) }}

        <div class="row">
            <div class="col-md-6">
                {{ form_row(form.priority) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.dueDate) }}
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                {{ form_row(form.labels) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.assignees) }}
            </div>
        </div>

        {# Checklists #}
        <div class="mt-4" data-controller="checklist">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h6 class="text-muted mb-0"><i class="bi bi-check2-square me-1"></i>{{ 'checklist.title'|trans }}</h6>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-action="checklist#addChecklist">
                    <i class="bi bi-plus me-1"></i>{{ 'checklist.add'|trans }}
                </button>
            </div>

            <div data-checklist-target="checklistList"
                 data-prototype="{{ form_widget(form.checklists.vars.prototype)|e('html_attr') }}"
                 data-index="{{ form.checklists|length }}">
                {% for checklist in form.checklists %}
                    {% set itemProto %}<div class="checklist-item-row d-flex align-items-center gap-2 mb-1"><i class="bi bi-grip-vertical text-muted item-drag-handle" style="cursor:grab;"></i>{{ form_widget(checklist.items.vars.prototype.checked) }}{{ form_widget(checklist.items.vars.prototype.position) }}{{ form_widget(checklist.items.vars.prototype.title, { attr: { class: 'form-control form-control-sm flex-grow-1' } }) }}<button type="button" class="btn btn-sm btn-link text-danger p-0" data-action="checklist#removeItem"><i class="bi bi-x-lg"></i></button></div>{% endset %}
                    <div class="card mb-2" data-checklist-target="checklist">
                        {{ form_widget(checklist.position) }}
                        <div class="card-header py-2 px-3 d-flex align-items-center gap-2">
                            <i class="bi bi-grip-vertical text-muted checklist-drag-handle" style="cursor:grab;"></i>
                            {{ form_widget(checklist.title, { attr: { class: 'form-control form-control-sm flex-grow-1' } }) }}
                            <button type="button" class="btn btn-sm btn-link text-danger p-0" data-action="checklist#removeChecklist">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                        <div class="card-body py-2 px-3">
                            <div data-checklist-target="itemList"
                                 data-prototype="{{ itemProto|e('html_attr') }}"
                                 data-index="{{ checklist.items|length }}">
                                {% for item in checklist.items %}
                                    <div class="checklist-item-row d-flex align-items-center gap-2 mb-1">
                                        <i class="bi bi-grip-vertical text-muted item-drag-handle" style="cursor:grab;"></i>
                                        {{ form_widget(item.checked) }}
                                        {{ form_widget(item.position) }}
                                        {{ form_widget(item.title, { attr: { class: 'form-control form-control-sm flex-grow-1' } }) }}
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0" data-action="checklist#removeItem">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                {% endfor %}
                            </div>
                            <button type="button" class="btn btn-sm btn-link ps-0 mt-1" data-action="checklist#addItem">
                                <i class="bi bi-plus me-1"></i>{{ 'checklist.add_item'|trans }}
                            </button>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="btn btn-sm btn-secondary" onclick="closeAjaxModal()">
                {{ 'common.cancel'|trans }}
            </button>
            <button type="submit" class="btn btn-sm btn-primary">
                {{ 'common.save'|trans }}
            </button>
        </div>
    {{ form_widget(form._token) }}
    {{ form_end(form, {render_rest: false}) }}

    {% if is_granted('ROLE_USER') %}
        <hr class="my-3">
        <form method="post" action="{{ path('app_card_delete', { id: card.id }) }}" data-ajax-form data-confirm="{{ 'card.confirm_delete'|trans }}">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ card.id) }}">
            <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-trash me-1"></i>{{ 'card.delete'|trans }}
            </button>
        </form>
    {% endif %}
</div>
