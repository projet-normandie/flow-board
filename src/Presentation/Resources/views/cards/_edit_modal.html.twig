<div class="ajax-modal-header">
    <div class="d-flex align-items-center gap-2">
        <h5 class="ajax-modal-title mb-0">{{ 'card.edit'|trans }}</h5>
        <span class="badge bg-secondary">{{ card.column.name }}</span>
    </div>
    <button type="button" class="ajax-modal-close" onclick="closeAjaxModal()">&times;</button>
</div>
<div class="ajax-modal-body">
    {{ form_start(form, { action: path('app_card_edit_modal', { id: card.id }), attr: { 'data-ajax-form': '' } }) }}
        {{ form_row(form.title) }}
        {{ form_row(form.description) }}

        <div class="row">
            <div class="col-md-6">
                {{ form_row(form.priority) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.dueDate) }}
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                {{ form_row(form.labels) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.assignees) }}
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="btn btn-sm btn-secondary" onclick="closeAjaxModal()">
                {{ 'common.cancel'|trans }}
            </button>
            <button type="submit" class="btn btn-sm btn-primary">
                {{ 'common.save'|trans }}
            </button>
        </div>
    {{ form_end(form) }}

    {% if is_granted('ROLE_USER') %}
        <hr class="my-3">
        <form method="post" action="{{ path('app_card_delete', { id: card.id }) }}" data-ajax-form data-confirm="{{ 'card.confirm_delete'|trans }}">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ card.id) }}">
            <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-trash me-1"></i>{{ 'card.delete'|trans }}
            </button>
        </form>
    {% endif %}
</div>
